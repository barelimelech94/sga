<?xml version="1.0" encoding="utf-8"?>
<!-- Rest notification bar: app colors instead of the system's gray, so the time left reads at a glance. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="5dp" />
            <solid android:color="@color/rest_bar_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="5dp" />
                <solid android:color="@color/rest_bar_fill" />
            </shape>
        </clip>
    </item>
</layer-list>
